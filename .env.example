# =================================================================
# BitNexa Environment Configuration Template
# =================================================================
# Copy this file to backend/.env or configure your environment variables.

# Server & Networking
PORT=5001

# Security & Authentication
JWT_SECRET=bitnexa-demo-secret
ADMIN_EMAIL=admin@bitnexa.com
ADMIN_PASSWORD=BitNexaAdmin2025!
ADMIN_SECRET=bitnexa-admin-super-secret

# Persistence (Leave empty to use high-speed in-memory store)
MONGODB_URI=mongodb://localhost:27017/bitnexa
MONGODB_DB_NAME=bitnexa

# Market Data Providers (Optional - public endpoints used if blank)
COINGECKO_API_KEY=

# Binance Exchange Configuration (Optional)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_LIVE_TRADING_ENABLED=false
